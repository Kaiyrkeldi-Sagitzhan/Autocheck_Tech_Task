# HTTP port the Go server listens on.
HTTP_PORT=8080

# Path to the SQLite database file.
DB_PATH=data/autocheck.db

# Directory watched for 1C export files.
IMPORT_DIR=data/imports

# Scheduled import interval (Go duration, e.g. 300s, 5m).
IMPORT_INTERVAL=5m

# Cron expression for scheduled imports (e.g. */5 * * * *).
IMPORT_CRON=

# Path to the CSV file to import on schedule.
IMPORT_FILE=
