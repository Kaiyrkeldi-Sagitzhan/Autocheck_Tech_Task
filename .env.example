# HTTP port the Go server listens on.
HTTP_PORT=8080

# Path to the SQLite database file.
DB_PATH=data/autocheck.db

# Directory watched for 1C export files.
IMPORT_DIR=data/imports

# Scheduled import interval (Go duration, e.g. 300s, 5m).
IMPORT_INTERVAL=5m

# Cron expression for scheduled imports (5-field standard cron, e.g. "0 * * * *").
IMPORT_CRON=

# Path to the CSV file to import on each scheduled run.
# MVP limitation: single fixed path; no directory scanning yet.
IMPORT_FILE=

# Enable or disable the scheduled importer without redeploying.
IMPORT_ENABLED=true

# Maximum duration for a single scheduled run before it is treated as failed/stuck.
IMPORT_TIMEOUT=5m
